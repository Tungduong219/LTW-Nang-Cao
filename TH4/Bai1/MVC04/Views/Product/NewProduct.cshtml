@model MVC04.Models.Product

@{
    ViewData["Title"] = "Thêm Mới Mặt Hàng";
}

<div class="container my-5">
    <div class="card shadow-sm border-1 mx-auto" style="max-width: 680px;">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0 fw-bold text-center">Thêm Mới Mặt Hàng (New Product)</h4>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @ViewBag.Success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="NewProduct" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label fw-semibold"></label>
                    <input asp-for="ProductName" class="form-control" required />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageURL" class="form-label fw-semibold"></label>
                    <input asp-for="ImageURL" class="form-control" required pattern="^.+\.(png|PNG)$" title="Đường dẫn ảnh phải có định dạng đuôi .png" placeholder="https://example.com/image.png" />
                    <span asp-validation-for="ImageURL" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductPrice" class="form-label fw-semibold"></label>
                    <input asp-for="ProductPrice" type="number" step="any" min="0" class="form-control" required />
                    <span asp-validation-for="ProductPrice" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Thêm Mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
