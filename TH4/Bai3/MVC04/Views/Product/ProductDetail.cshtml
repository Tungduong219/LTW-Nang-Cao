@model MVC04.Models.Product

@{
    ViewData["Title"] = "Chi Tiết - " + Model.ProductName;
}

<div class="container my-4">
    <div class="mb-3">
        <a asp-controller="Product" asp-action="ProductList" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách sản phẩm (Product List)
        </a>
    </div>

    <div class="card shadow-sm border-2">
        <div class="card-header bg-light py-3">
            <h3 class="mb-0 text-dark fw-bold">Chi Tiết Mặt Hàng #@Model.ProductID</h3>
        </div>
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-5 text-center mb-4 mb-md-0">
                    <div class="border rounded p-2 bg-white d-inline-block shadow-sm">
                        <img src="@Model.ImageURL" alt="@Model.ProductName" class="img-fluid rounded" style="max-height: 350px; object-fit: cover;" />
                    </div>
                </div>

                <div class="col-md-7">
                    <span class="badge bg-secondary mb-2">Mã sản phẩm: @Model.ProductID</span>
                    <h2 class="fw-bold text-primary mb-3">@Model.ProductName</h2>
                    
                    <div class="p-3 mb-3 bg-light rounded border">
                        <span class="text-muted d-block">Đơn giá:</span>
                        <span class="fs-2 fw-bold text-danger">@Model.ProductPrice.ToString("N0") VND</span>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-semibold">Mô tả chi tiết:</h5>
                        <p class="text-secondary lead fs-6" style="line-height: 1.6;">
                            @Model.Description
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <form asp-controller="Product" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productId" value="@Model.ProductID" />
                            <button type="submit" class="btn btn-success btn-lg px-4">
                                Add To Cart
                            </button>
                        </form>
                        <a asp-controller="Product" asp-action="ProductList" class="btn btn-outline-dark btn-lg px-4">
                            Tiếp tục xem hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
